# Copy to config.env and replace every placeholder. Never commit config.env.
NODE_ENV=development
PORT=4000
FRONTEND_URL=https://your-store.example
DASHBOARD_URL=https://your-admin.example

# Use a randomly generated secret with at least 32 characters.
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
COOKIE_EXPIRES_IN=1

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ecommerce_app
DB_PASSWORD=replace_with_a_unique_database_password
DB_NAME=mern_ecommerce_store
DB_POOL_MAX=10
DB_SSL=false

# Stripe (use new keys; rotate the previously exposed key)
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=usd
# Multiplier from catalog price units to Stripe currency units; keep 1 for USD-priced catalog.
STRIPE_AMOUNT_MULTIPLIER=1

# Cloudinary
CLOUDINARY_CLIENT_NAME=replace_me
CLOUDINARY_CLIENT_API=replace_me
CLOUDINARY_CLIENT_SECRET=replace_me

# SMTP (needed for password recovery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_MAIL=no-reply@example.com
SMTP_PASSWORD=replace_me
